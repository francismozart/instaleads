# ─────────────────────────────────────────────────────────────────────────────
# instaleads — environment configuration
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# See SETUP.md for the step-by-step operator guide (in Portuguese).
# ─────────────────────────────────────────────────────────────────────────────

# ── OpenAI ──────────────────────────────────────────────────────────────────
# Create a Restricted key in a dedicated project and set a monthly hard limit:
# https://platform.openai.com/api-keys  →  Settings → Limits
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Exact model ids — no floating aliases in production.
OPENAI_MODEL=gpt-4.1
OPENAI_MODEL_FAST=gpt-4.1-mini
# Hard monthly ceiling (USD). The worker pauses the whole system when reached.
OPENAI_MONTHLY_BUDGET_USD=50

# ── Chrome (browser first-contact via CDP) ───────────────────────────────────
# The agent connects to a Chrome the OPERATOR launched with a dedicated profile
# and remote debugging bound to 127.0.0.1. It NEVER launches its own Chrome.
CHROME_CDP_URL=http://127.0.0.1:9222
# Dedicated profile dir (separate from the operator's personal Chrome profile).
CHROME_PROFILE_DIR=./.chrome-profile

# ── Instagram official API + webhook (Meta) ──────────────────────────────────
INSTAGRAM_APP_SECRET=your_meta_app_secret
INSTAGRAM_PAGE_ACCESS_TOKEN=your_long_lived_page_access_token
INSTAGRAM_WEBHOOK_VERIFY_TOKEN=choose_a_long_random_string
INSTAGRAM_BUSINESS_ACCOUNT_ID=1784xxxxxxxxxxx

# ── Database (SQLite, single source of truth) ────────────────────────────────
# Plain filesystem path. WAL mode + busy_timeout are enabled by the app.
DATABASE_URL=data/instaleads.db

# ── Human-rhythm sending controls (account health, not evasion) ──────────────
MAX_DMS_PER_DAY=30
MIN_SECONDS_BETWEEN_DMS=90
MAX_SECONDS_BETWEEN_DMS=240
# Operating window "HH:MM-HH:MM" in OPERATING_TIMEZONE.
OPERATING_HOURS=09:00-20:00
OPERATING_TIMEZONE=America/Sao_Paulo

# ── Runtime secret used to encrypt browser session state at rest ─────────────
# 32+ random chars. Generate: `openssl rand -hex 32`
STATE_ENCRYPTION_KEY=change_me_to_a_long_random_hex_string
